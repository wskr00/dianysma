# Local development. Copy these values into the existing .env as needed.
SERVER_PORT=8000
MCP_ENDPOINT_PATH=/mcp
# Keep enabled locally. Set to true in AgentCore only if its proxy host is rejected by the MCP SDK.
MCP_DISABLE_LOCALHOST_PROTECTION=false
# Set false to skip model-change reindexing at startup; the explicit `reindex` command still forces it.
KNOWLEDGE_AUTO_REINDEX=true
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=dianysma
DATABASE_USER=dianysma
DATABASE_PASSWORD=dianysma
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX_SIZE=4
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536

# AWS runtime only: set this on AgentCore. AWS_REGION comes from the runtime.
# Store DATABASE_*, GEMINI_API_KEY, and (if using Neon pooler) DATABASE_MIGRATION_HOST
# together in this Secrets Manager secret.
# AWS_SECRET_ID=dianysma/prod/runtime
