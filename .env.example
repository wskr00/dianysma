DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=dianysma
DATABASE_USER=dianysma
DATABASE_PASSWORD=dianysma
GEMINI_API_KEY=
# Cognito User Pool issuer URI (without /.well-known/openid-configuration).
COGNITO_ISSUER_URI=
# Canonical HTTPS MCP resource URI; also send this as OAuth's `resource` parameter.
MCP_RESOURCE_URI=
# Exact OAuth scopes expected in the access token's `scope` claim.
# Set these to match the Cognito resource-server identifier and scopes.
KNOWLEDGE_READ_SCOPE=dianysma/knowledge.read
KNOWLEDGE_WRITE_SCOPE=dianysma/knowledge.write
